function buildBeatId() => 100 * low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09d) +
                          10 * low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09e) +
                          low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09f)

function totalStarCount() => dword_be((dword_be((dword_be(0x797aa8) & 0x1fffffff) + 0xbc) & 0x1fffffff) + 0x1550)

function inGame() => dword_be(0x797acc) != 0
function inSong() => dword_be(0x00797d88) != 0 || 1 == 1

cheats = {
    0: "",
}

function sumOfCheats() => dword_be(0x4f4e8c) + dword_be(0x4f4ec4) + dword_be(0x4f4efc) + dword_be(0x4f4f34) + 
                          dword_be(0x4f4f6c) + dword_be(0x4f4fa4) + dword_be(0x4f4fdc) + dword_be(0x4f5014) +
                          dword_be(0x4f504c) + dword_be(0x4f5084) + dword_be(0x4f50bc) + dword_be(0x4f50f4) +
                          dword_be(0x4f512c) + dword_be(0x4f5164) + dword_be(0x4f519c) + dword_be(0x4f51d4) +
                          dword_be(0x4f52ec) + dword_be(0x4f5324) + dword_be(0x4f535c)
function isNotCheating() => sumOfCheats() == 0

function currentSongDifficulty(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    diff = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x08)
    return diff
}

function currentSongScore(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    score = float_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x34)
    return score
}

function currentSongStars(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    stars = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x298)
    return stars
}

function currentSong6StarsThreshold(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    threshold = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x278)
    return threshold
}

function currentBeatState(){
    return dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x35b0)
}

function currentStreak(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    streak = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x1d4)
    return streak
}

function rewindsUsed(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    rewinds = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x244)
    return rewinds
}

function perfectSectionsHit(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    perfects = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x254)
    return perfects
}

function perfectSectionsTotal(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    perfects = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x25c)
    return perfects
}

function euphoriasUsed(){
    index = dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b4)
    euphorias = dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x6a4 * index + 0x24c)
    return euphorias
}


rich_presence_conditional_display(inGame() && inSong(), "{6} · {2} · {7} · Score: {8} · Total Stars: {0}/465 {1} => {3}{4}{5}", 
                                  rich_presence_value("Value", totalStarCount(), "VALUE"),
                                  rich_presence_lookup("Cheats", sumOfCheats(), cheats, fallback=" - Using Cheats"),
                                  rich_presence_lookup("Beat", buildBeatId(), beatName, fallback="Unknown Beat"),
                                  rich_presence_value("ASCIIChar", low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09d)),
                                  rich_presence_value("ASCIIChar", low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09e)),
                                  rich_presence_value("ASCIIChar", low4((dword_be((dword_be(0x797d64) & 0x1fffffff) + 0x356c) & 0x1fffffff) + 0x09f)),
                                  rich_presence_lookup("Setlist", dword_be((dword_be(0x797ac0) & 0x1fffffff) + 0x3b0), setlist),
                                  rich_presence_lookup("Difficulty", currentSongDifficulty(), difficulty),
                                  rich_presence_value("Score", currentSongScore(), "SCORE")
)

rich_presence_conditional_display(inGame(), "In the Hub · Total Stars: {0}/465 {1}", 
                                  rich_presence_value("Value", totalStarCount(), "VALUE"),
                                  rich_presence_lookup("CHEATS", sumOfCheats(), cheats, fallback=" - Using Cheats")
)

rich_presence_display("Playing DJ Hero")

basicTutorialsOffsets = [0x11e0, 0x11f0, 0x1200, 0x1210, 0x1220]
advancedTutorialsOffsets = [0x1230, 0x1240, 0x05d0, 0x1250, 0x0640, 0x05c0]

function masteringTutorials(offsets){
    prev = always_false()
    mem = always_true()
    for offset in offsets{
        prev = prev || prev(dword_be((dword_be((dword_be(0x797aa8) & 0x1fffffff) + 0xbc) & 0x1fffffff) + offset)) != 0x180
        mem = mem && dword_be((dword_be((dword_be(0x797aa8) & 0x1fffffff) + 0xbc) & 0x1fffffff) + offset) == 0x180
    }
    return isNotCheating() && inGame() && prev && mem
}

achievement(title="Mastering the Basics", points=1,
            description="Master all Basic Tutorial entries",
            trigger=masteringTutorials(basicTutorialsOffsets)
)

achievement(title="Advanced Degree", points=2,
            description="Master all Advanced Tutorial entries",
            trigger=masteringTutorials(advancedTutorialsOffsets)
)

